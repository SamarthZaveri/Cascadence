# Copy to .env and fill in. Field names here are contractual — see DATA_CONTRACT.md §1.
# Values below are safe local-dev defaults except where marked REQUIRED.

ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

POSTGRES_USER=cascadence
POSTGRES_PASSWORD=cascadence
POSTGRES_DB=cascadence
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# REQUIRED for Phase 2 (SEC EDGAR requires a compliant User-Agent, not a key)
SEC_EDGAR_USER_AGENT="Your Name your.email@example.com"
NEWS_API_KEY=
# REQUIRED for Phase 3 (Copernicus Data Space Ecosystem — free account)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# REQUIRED for Phase 7 (LLM briefings)
ANTHROPIC_API_KEY=

# Optional — alerting dispatch (Phase 9)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SLACK_WEBHOOK_URL=

PROMETHEUS_ENABLED=true

# Phase 1 local CLI; Compose overrides this to /artifacts.
MODEL_ARTIFACT_DIR=../ml/training/artifacts
